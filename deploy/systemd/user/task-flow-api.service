[Unit]
Description=Task Flow FastAPI application
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/qkrtkdals/vibe-lab/flow-task
EnvironmentFile=/home/qkrtkdals/vibe-lab/flow-task/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/qkrtkdals/vibe-lab/flow-task/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8003
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
